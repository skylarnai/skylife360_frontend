# Copy to .env and adjust.
VITE_APP_NAME=Sky Life 360

# Leave empty in dev: Vite proxies /api to VITE_PROXY_TARGET. Set a full URL for production builds.
VITE_API_BASE_URL=
VITE_PROXY_TARGET=http://127.0.0.1:8000
VITE_API_PREFIX=/api/v1

# Set to false to use the live FastAPI backend auth APIs (/api/v1/auth/*)
VITE_AUTH_MOCK=false

# Dev convenience: show API panel and account helper buttons
VITE_SHOW_API_PANEL=true
