# Copy to .env and adjust.
VITE_APP_NAME=Sky Life 360

# Leave empty in dev: Vite proxies /api to VITE_PROXY_TARGET. Set a full URL for production builds.
VITE_API_BASE_URL=
VITE_PROXY_TARGET=http://127.0.0.1:8000
VITE_API_PREFIX=/api/v1

# Dev convenience: show the API panel and auto-fill the backend's dev MFA code / reset token
VITE_SHOW_API_PANEL=true

# Ask step (RAG answers). Needs an LLM configured on the backend (LLM_MODEL_PATH or LLM_PROVIDER=openai_compatible).
VITE_ENABLE_ASK=false
# Ask for the Doctor / Staff flow only (S06 "Ask about a patient" tab). Same backend LLM requirement.
VITE_ENABLE_CLINICAL_ASK=false

# Multi-tenancy: default hospital tenant ID
VITE_DEFAULT_TENANT_ID=HOSP-001
