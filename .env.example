# Copy to .env and adjust.
VITE_APP_NAME=Sky Claims Desk
# Leave empty in dev: Vite proxies /api to VITE_PROXY_TARGET. Set a full URL for production builds.
VITE_API_BASE_URL=
VITE_PROXY_TARGET=http://127.0.0.1:8000
VITE_API_PREFIX=/api/v1
# Dev-only controls
VITE_SHOW_API_PANEL=true
VITE_AUTH_MOCK=true
VITE_MOCK_ROLE=admin
# Server-side only (used by Vite dev proxy, never bundled into browser JS)
BACKEND_API_KEY=
